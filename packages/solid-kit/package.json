{
  "name": "@edenapp/solid-kit",
  "version": "0.10.2",
  "description": "High-level SolidJS UI primitives for Eden apps",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./dialogs": {
      "types": "./src/dialogs.ts",
      "import": "./src/dialogs.ts",
      "default": "./src/dialogs.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "solid-icons": "^1.1.0"
  },
  "devDependencies": {
    "@edenapp/types": "workspace:*",
    "@solidjs/testing-library": "^0.8.10",
    "jsdom": "^26.1.0",
    "typescript": "^5.3.0",
    "vite": "^6.4.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "eden",
    "solid",
    "dialog",
    "renderer"
  ],
  "author": "Dariusz Majnert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/eden.git",
    "directory": "packages/solid-kit"
  }
}
