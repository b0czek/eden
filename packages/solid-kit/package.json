{
  "name": "@edenapp/solid-kit",
  "version": "0.17.0",
  "description": "High-level SolidJS UI primitives for Eden apps",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./datetime": {
      "types": "./src/datetime.ts",
      "import": "./src/datetime.ts",
      "default": "./src/datetime.ts"
    },
    "./dialogs": {
      "types": "./src/dialogs.ts",
      "import": "./src/dialogs.ts",
      "default": "./src/dialogs.ts"
    },
    "./locale": {
      "types": "./src/locale.ts",
      "import": "./src/locale.ts",
      "default": "./src/locale.ts"
    },
    "./notices": {
      "types": "./src/notices.ts",
      "import": "./src/notices.ts",
      "default": "./src/notices.ts"
    },
    "./sidebar": {
      "types": "./src/sidebar.tsx",
      "import": "./src/sidebar.tsx",
      "default": "./src/sidebar.tsx"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "catalog:"
  },
  "dependencies": {
    "@edenapp/babel": "workspace:*",
    "@edenapp/client": "workspace:*",
    "solid-icons": "catalog:"
  },
  "devDependencies": {
    "@edenapp/types": "workspace:*",
    "@solidjs/testing-library": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  },
  "keywords": [
    "eden",
    "solid",
    "dialog",
    "renderer"
  ],
  "author": "Dariusz Majnert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/eden.git",
    "directory": "packages/solid-kit"
  }
}
