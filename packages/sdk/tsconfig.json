{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022", "ESNext.Error"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "NodeNext",
    "types": ["jest", "node"],
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "namespaceImportPackages": ["effect"],
        "diagnosticSeverity": {
          "floatingEffect": "error",
          "missingEffectContext": "error",
          "missingEffectError": "error",
          "missingLayerContext": "error",
          "leakingRequirements": "error",
          "unsafeEffectTypeAssertion": "error",
          "runEffectInsideEffect": "error",
          "globalTimers": "error",
          "globalTimersInEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "anyUnknownInErrorContext": "warning",
          "globalErrorInEffectCatch": "warning",
          "globalErrorInEffectFailure": "warning",
          "unknownInEffectCatch": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "importFromBarrel": "error"
        }
      }
    ]
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "apps",
    "edencss",
    "foundation",
    "src/app-frame",
    "src/app-runtime",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
