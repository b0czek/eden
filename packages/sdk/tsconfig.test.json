{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "isolatedModules": true,
    "rootDir": ".",
    "types": ["jest", "node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/support/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/app-frame", "src/app-runtime"]
}
