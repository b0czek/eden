{
  "name": "@edenapp/files-core",
  "version": "0.10.1",
  "description": "Reusable file explorer primitives for Eden apps",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate:icons": "node scripts/generate-noto-icons.mjs",
    "prepare": "pnpm run generate:icons",
    "build": "pnpm run generate:icons && tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "solid-icons": "catalog:"
  },
  "devDependencies": {
    "@edenapp/types": "workspace:*",
    "@iconify-json/noto": "^1.2.7",
    "@iconify/utils": "^3.1.4",
    "typescript": "catalog:"
  },
  "keywords": [
    "eden",
    "files",
    "explorer",
    "solid"
  ],
  "author": "Dariusz Majnert",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/b0czek/eden.git",
    "directory": "packages/files-core"
  }
}
