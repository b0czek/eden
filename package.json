{
  "name": "@edenapp/eden",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.15.0"
  },
  "description": "Eden Desktop Environment",
  "scripts": {
    "build": "pnpm run build:packages && pnpm install --config.confirmModulesPurge=false",
    "build:packages": "pnpm --filter @edenapp/sdk run codegen && pnpm -r --filter=!@edenapp/eden --filter=!@edenapp/example --filter=!./packages/sdk/apps/** run build",
    "clean": "rm -rf dist packages/*/dist",
    "dev": "pnpm --filter @edenapp/sdk dev",
    "dev:example": "cd packages/example && pnpm dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm run test:unit && pnpm run test:integration:node",
    "pretest:unit": "pnpm run build:packages",
    "test:unit": "pnpm --filter @edenapp/sdk run test:unit && pnpm -r --filter '!@edenapp/sdk' --if-present run test",
    "test:integration:node": "pnpm --filter @edenapp/sdk run test:integration:node",
    "test:integration:electron": "pnpm --filter @edenapp/sdk run test:integration:electron",
    "typecheck": "bash ./scripts/ci-typecheck.sh",
    "lint-staged": "lint-staged",
    "prepare": "pnpm --filter @edenapp/files-core run prepare && simple-git-hooks",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm run build && changeset publish",
    "check:effects": "pnpm --filter @edenapp/sdk run check:effects"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@changesets/cli": "^3.0.3",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,json,jsonc,css}": "biome check --write"
  }
}
