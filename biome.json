{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "files": {
    "includes": [
      "**",
      "!**/src/generated",
      "!**/*.generated.*",
      "!packages/types/*.generated.d.ts"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/sdk/src/**/*.ts",
        "!packages/sdk/src/**/*.test.ts",
        "!packages/sdk/src/Eden.ts",
        "!packages/sdk/src/platform/electron/**",
        "!packages/sdk/src/app-runtime/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "electron": "Runtime code must use platform ports instead of Electron."
                },
                "patterns": [
                  {
                    "group": [
                      "**/platform/electron",
                      "**/platform/electron/**"
                    ],
                    "message": "Runtime code must not import production Electron adapters."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/sdk/apps/**/*icon.svg"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          }
        }
      }
    }
  ]
}
